{
  "harness": "C:/path/to/jobharness",
  "state_dir": "C:/path/to/jobharness/pipeline/state",
  "resume_prefix": "Resume",
  "query": {
    "titles": [
      "Solutions Engineer",
      "Implementation Engineer",
      "Integration Engineer",
      "Automation Engineer"
    ],
    "country_code": ["US"],
    "searches": [
      {
        "name": "us-remote",
        "work_arrangement": ["Remote Solely", "Remote OK"]
      },
      {
        "name": "local",
        "work_arrangement": ["Hybrid", "On-site"],
        "cities": ["Your City"]
      }
    ],
    "exclude_hq_cities": [],
    "date_posted_days": 3,
    "is_agency": false,
    "page_size": 50,
    "max_pages_per_search": 12
  },
  "limits": {
    "max_candidates": 500,
    "max_applications_per_day": 50,
    "max_captcha_solves_per_day": 10
  },
  "notify": {
    "email": "you@example.com",
    "discord_webhook_file": "C:/path/to/jobharness/pipeline/discord_webhook.txt",
    "discord_channel_id": "",
    "discord_bot_token_file": "C:/path/to/jobharness/pipeline/discord_bot_token.txt",
    "retro_webhook_file": "C:/path/to/jobharness/pipeline/discord_retro_webhook.txt"
  },
  "retro": {
    "enabled": true,
    "agent_timeout_seconds": 3600,
    "grace_runs": 2,
    "max_changes_per_run": 6
  },
  "pow": {
    "enabled": false,
    "daily": false,
    "publish_enabled": false,
    "attach_enabled": false,
    "max_per_day": 1,
    "agent_budget_usd": 2.0,
    "exec_timeout_seconds": 60,
    "window_days": 7,
    "signal_window_days": 30,
    "treg_budget_usd": 0.75
  },
  "gws": {
    "node": "C:/Program Files/nodejs/node.exe",
    "cli": "C:/path/to/node_modules/@googleworkspace/cli/run-gws.js"
  }
}
